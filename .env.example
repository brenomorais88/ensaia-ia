# ensaia-ia — modelo de configuração local.
# Copie para .env e preencha. .env NUNCA é commitado (.gitignore: .env*).

# Nome do ambiente, aparece no /health. Local/HML/PROD.
ENV=local

# --- Agente avaliador (fase-1-criterios.md) ---
OPENAI_API_KEY=

# Autentica POST /veredito — mesmo valor de VEREDITO_SERVICE_TOKEN no backend Kotlin
# (ensa-ia-back/.env.local, integracao-voz-criterios.md). Segredo compartilhado, não
# autenticação de usuário.
VEREDITO_SERVICE_TOKEN=

# Opcional — observabilidade via LangSmith (tier grátis, plano-arquitetura.md).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ensaia-ia

# --- Agente entrevistador + WebSocket /interview (fase-2-criterios.md) ---

# Valida o token efêmero emitido pelo Kotlin em POST /tentativas/:id/voice-token —
# mesmo valor de VOICE_TOKEN_SECRET no backend Kotlin (ensa-ia-back/.env.local).
VOICE_TOKEN_SECRET=

# Credenciais AWS pro Amazon Polly (TTS, plano-arquitetura.md) — IAM de uso restrito
# (permissão só pra polly:SynthesizeSpeech), nunca a chave root da conta.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
